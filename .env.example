# Copia este fichero como ".env" y rellena los valores.
# El fichero .env no se sube a git (está en .gitignore).

# --- Elasticsearch ---
# Contraseña del usuario "elastic". Con docker-compose.yml se fija al crear el contenedor.
ES_PASSWORD=cambia_esta_contraseña
ES_USER=elastic
ES_URL=http://localhost:9200

# --- Modelos de Hugging Face ---
# Carpeta donde se descargan los modelos (necesita varias decenas de GB).
# Si se deja vacía, se usa la carpeta por defecto de Hugging Face (~/.cache/huggingface).
HF_CACHE_DIR=
